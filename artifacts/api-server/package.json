    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "http-proxy-middleware": "^4.2.0",
    "libphonenumber-js": "^1.13.12",
    "nodemailer": "^6.9.16",
    "pg": "^8.22.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
