# LeadSprint — environment variables reference
#
# Copy to .env for local/Docker use (`docker run --env-file .env ...`), or
# set these in Coolify's application → Environment Variables screen.
# Nothing here is a real secret — placeholders only.
#
# Vars marked (required) will crash the app at boot / on first use if
# missing. Everything else fails closed into demo mode: missing provider
# credentials disable that specific provider (visible on GET /api/readyz)
# rather than half-working or crashing.

# ---- Core (required) ------------------------------------------------------
#
# DATABASE_URL notes (each of these has caused a failed deploy):
#  - Use the database's INTERNAL service name on Coolify, never localhost.
#  - URL-encode special characters in the password (@ becomes %40).
#  - TLS: `sslmode=require` is treated by `pg` as `verify-full`, which fails
#    with "unable to verify the first certificate" against a database that has
#    a self-signed certificate (a Coolify database). `sslmode=required` is not a
#    valid value at all. On a private network use:
#      ?uselibpqcompat=true&sslmode=require
#    (encrypts, does not verify the server identity). Across the public
#    internet, verify the CA instead (sslmode=verify-full + sslrootcert).
#  - Coolify applies a database's user/password only when its volume is first
#    created; changing them in the UI later does not change the database.
DATABASE_URL=postgres://user:password@host:5432/leadsprint?uselibpqcompat=true&sslmode=require
PORT=5000
NODE_ENV=production
# Pool ceiling and connect timeout (ms). The timeout makes a database that
# silently drops packets fail loudly at boot instead of hanging forever.
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
# How long GET /api/readyz waits for the database before answering 503.
READYZ_DB_TIMEOUT_MS=3000

# ---- Auth (required for the operator console; health/webhooks/cron work
# without it — see routes/index.ts) -----------------------------------------
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# VITE_* values are baked into the console at BUILD time. On Coolify, tick
# "Available at Buildtime" for them and redeploy (a restart is not enough).
# Without VITE_CLERK_PUBLISHABLE_KEY the console shows "Sign-in is not
# configured" instead of a login.
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PROXY_URL=

# ---- Voice: Retell AI (optional — falls back to demo mode) ----------------
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_WEBHOOK_SECRET=
# Prefer the market-specific numbers; RETELL_FROM_NUMBER is a fallback for
# both if you're only running one market for now.
RETELL_FROM_NUMBER=
RETELL_FROM_NUMBER_US=
RETELL_FROM_NUMBER_IN=

# ---- Telephony: Twilio (optional — used for inbound routing/status) -------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_SECRET=
TWILIO_FROM_NUMBER_US=
TWILIO_FROM_NUMBER_IN=

# ---- Calendar: Cal.com (optional — falls back to demo availability) -------
CALCOM_API_KEY=
CALCOM_API_URL=https://api.cal.com/v2
CALCOM_EVENT_TYPE_ID=
CALCOM_WEBHOOK_SECRET=

# ---- Lead intake webhook (optional) ---------------------------------------
LEAD_INTAKE_WEBHOOK_SECRET=
# Lets a no-code sender (Zapier, Make) authenticate intake by sending the secret
# above in an `x-leadsprint-key` header instead of an HMAC signature. OFF by
# default. It is weaker (a captured request can be replayed), so use it only over
# HTTPS with a secret unique to this deployment. See docs/meta-lead-ads.md.
INTAKE_ALLOW_KEY_AUTH=false

# ---- Scheduled jobs (POST /api/cron/*, header x-cron-secret) --------------
# Required to use any /api/cron/* endpoint at all. Generate with:
#   openssl rand -hex 32
CRON_SECRET=
RETENTION_DAYS=90

# ---- Internal call-dispatch worker (replaces external cron for single-box) --
# Set ENABLE_INTERNAL_WORKER=true to have the server auto-dispatch queued
# calls every 30 seconds without needing an external cron or scheduler. Safe
# for demo and Coolify single-container pilots, and safe to run alongside
# POST /api/cron/process-jobs: jobs are claimed with a conditional UPDATE, so
# only one dispatcher can dial a given call. For multi-instance production,
# either is fine for the same reason — the shared database is the lock.
ENABLE_INTERNAL_WORKER=false
# Override the dispatch interval in milliseconds (default: 30000 = 30s).
# Clamped to 5000–300000 ms. Lower values increase Retell API call frequency.
INTERNAL_WORKER_INTERVAL_MS=30000

# ---- Weekly report email via SMTP (optional — no-ops per business if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Ops alerting (POST /api/cron/health-alerts; needs SMTP above)
ALERT_EMAIL=
ALERT_FAILED_CALLS_THRESHOLD=3

# ---- Safety kill switch ----------------------------------------------------
# Set to "true" to immediately stop all new outbound calling across every
# business, regardless of other settings. Existing in-flight calls are
# unaffected; this only blocks new ones from POST /calls/start onward.
LEADSPRINT_KILL_SWITCH=false

# ---- Demo seed data (NEVER set on a customer deployment) -------------------
# Writes the fictional "Northstar Realty" workspace with fake leads, calls and
# appointments into the database. Ignored when NODE_ENV=production. A pilot
# customer must never see invented leads in their console.
LEADSPRINT_DEMO_SEED=false

# ---- Local demo auth (NEVER set on a public deployment) --------------------
# Runs the operator console against the seeded demo business with NO
# authentication at all. Requires BOTH of these, and the server refuses to
# honour it when NODE_ENV=production:
#   LEADSPRINT_DEMO_AUTH=true        (API server, runtime)
#   VITE_LEADSPRINT_DEMO_AUTH=true   (frontend, build time — bakes out Clerk)
# GET /api/readyz reports "auth":"demo" when it's active.
LEADSPRINT_DEMO_AUTH=false
VITE_LEADSPRINT_DEMO_AUTH=false

# ---- Reverse proxy ----------------------------------------------------------
# Number of trusted proxy hops in front of the app (Coolify/Traefik = 1).
# Required for req.protocol/req.ip to be correct, which the Twilio webhook
# signature check depends on. Set to "false" when exposed directly.
TRUST_PROXY=1

# ---- CORS -------------------------------------------------------------------
# Comma-separated exact origins allowed to call the API from a browser.
# Only needed for a SPLIT deployment (console and API on different
# origins). The default single-container deployment is same-origin and
# needs nothing here: production emits no CORS headers at all, and local
# dev allows loopback origins (http://localhost:<vite-port>) so `pnpm dev`
# keeps working. Malformed entries crash the boot loudly. Example:
# CORS_ORIGINS=https://console.example.com
CORS_ORIGINS=

# ---- Rate limiting (per client IP, per window) --------------------------------
# Ceilings for the surfaces reachable without an operator session. Counts
# live in process memory, which is correct for the single-container
# deployment; see middlewares/rateLimit.ts before scaling past one
# instance. Defaults: 15-minute window, 600 webhook / 300 agent / 60 cron.
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_WEBHOOK_MAX=
RATE_LIMIT_AGENT_MAX=
RATE_LIMIT_CRON_MAX=

# ---- Logging ----------------------------------------------------------------
LOG_LEVEL=info

# ---- Set automatically by the Dockerfile — do not set manually ------------
# STATIC_DIR=/repo/artifacts/leadsprint/dist/public
